# ===========================================
# NetShield AI - Environment Configuration
# ===========================================

# Application
APP_NAME=NetShield AI
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# PostgreSQL
POSTGRES_USER=netshield
POSTGRES_PASSWORD=netshield_secret
POSTGRES_DB=netshield_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://netshield:netshield_secret@db:5432/netshield_db

# MongoDB
MONGO_USER=netshield
MONGO_PASSWORD=netshield_mongo
MONGO_DB=netshield_traffic
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_URL=mongodb://netshield:netshield_mongo@mongodb:27017/netshield_traffic?authSource=admin

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Celery
CELERY_BROKER_URL=redis://redis:6379/5
CELERY_RESULT_BACKEND=redis://redis:6379/5

# pgAdmin
PGADMIN_EMAIL=admin@netshield.io
PGADMIN_PASSWORD=admin

# Mongo Express
ME_USER=admin
ME_PASSWORD=admin

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:80/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:80/ws
NEXT_PUBLIC_APP_NAME=NetShield AI
