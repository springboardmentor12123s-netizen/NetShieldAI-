# ---- Auth ----
SECRET_KEY=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REMEMBER_ME_EXPIRE_MINUTES=20160
RESET_TOKEN_EXPIRE_MINUTES=30

# ---- MongoDB (primary database) ----
# Local:            mongodb://localhost:27017
# MongoDB Atlas:    mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=netshield_ai

# ---- PostgreSQL (optional, not required — see app/postgres_db.py) ----
# Leave blank until you're ready to use it. The app works fully without it.
# POSTGRES_URI=postgresql+asyncpg://<user>:<password>@localhost:5432/netshield_ai
POSTGRES_URI=

# ---- CORS ----
# Comma-separated list of frontend origins allowed to call this API
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Dataset ----
# Path is relative to backend/ folder. Put your CSV here.
DATASET_PATH=app/data/network_traffic.csv

# ---- Model ----
MODEL_PATH=app/ml/model.pkl
MODEL_METRICS_PATH=app/ml/model_metrics.json

# ---- SMTP (Feature 2: password reset emails, Feature 3: critical alert emails) ----
# Example for Gmail: create an "App Password" (not your normal password) at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASSWORD.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=true
EMAIL_FROM_NAME=NetShield AI

# Base URL of the deployed frontend — used to build the link inside reset emails
FRONTEND_BASE_URL=http://localhost:5173

# ---- Critical Alert Emails (Feature 3) ----
# Email is sent automatically when risk_score >= this value OR severity == critical
CRITICAL_ALERT_RISK_THRESHOLD=90
CRITICAL_ALERTS_ENABLED=true
# Who receives critical alert emails. If blank, falls back to the first admin's email.
SECURITY_TEAM_EMAIL=

# ---- Live Packet Capture (Feature 1) ----
# Leave blank to let Scapy auto-select the default interface.
# Linux: e.g. eth0 | macOS: e.g. en0 | Windows: e.g. Ethernet (requires Npcap)
CAPTURE_INTERFACE=
CAPTURE_FLOW_TIMEOUT_SECONDS=3
CAPTURE_BPF_FILTER=ip

# ---- Dataset Uploads (Feature 5) ----
UPLOAD_DIR=app/data/uploads
