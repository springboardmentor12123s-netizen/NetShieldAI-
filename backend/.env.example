# PostgreSQL connection string – REQUIRED.
# Copy this file to .env and fill in your actual credentials.
#
# Steps:
#   1. Install PostgreSQL and create the database:
#        CREATE DATABASE netshield_ai;
#   2. Replace the values below with your PostgreSQL host, port, user, and password.
#   3. Copy this file:  cp .env.example .env
#   4. Start the backend normally.

DATABASE_URL=postgresql://user:password@localhost:5432/netshield_ai

# Optional – override the allowed frontend origin for CORS. 
# You can provide a comma-separated list of origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
