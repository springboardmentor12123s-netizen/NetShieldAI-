# PostgreSQL connection string – REQUIRED.
# Copy this file to .env and fill in your actual credentials.
#
# Steps:
#   1. Install PostgreSQL and create the database:
#        CREATE DATABASE netshield_ai;
#   2. Replace the values below with your PostgreSQL host, port, user, and password.
#   3. Copy this file:  cp .env.example .env
#   4. Start the backend normally.

DATABASE_URL=postgresql://postgres:password@localhost:5432/netshield_ai

# Optional – override the allowed frontend origin for CORS.
# FRONTEND_URL=http://localhost:5173
